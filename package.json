{
	"name": "obsidian-pdf-dict-translator",
	"version": "1.0.0",
	"description": "Look up words in Cambridge, Oxford, or Dictionary.com and translate text with a sleek floating toolbar on desktop and mobile.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"dictionary",
		"translator",
		"cambridge-dictionary",
		"oxford-dictionary",
		"pdf-reader"
	],
	"author": "quiqxiq",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/quiqxiq/obsidian-pdf-dict-translator.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0"
	}
}
